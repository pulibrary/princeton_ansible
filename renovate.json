{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "customManagers:dockerfileVersions"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Keep the supported Python version managed manually",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "matchManagers": ["pep621"],
      "rangeStrategy": "bump"
    },
    {
      "description": "ansible 15.x requires ansible-core 2.22.x; raise this when moving to ansible 16",
      "matchPackageNames": ["ansible-core"],
      "allowedVersions": "<2.23"
    },
    {
      "description": "passlib 1.7.4 runs a >72-byte self-test that bcrypt 5 rejects, breaking password_hash('bcrypt'); lift when passlib is replaced",
      "matchPackageNames": ["bcrypt"],
      "allowedVersions": "<5"
    }
  ]
}
