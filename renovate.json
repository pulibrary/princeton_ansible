{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:allNonMajor",
    "customManagers:dockerfileVersions"
  ],
  "lockFileMaintenance": {
    "enabled": true
  },
  "packageRules": [
    {
      "description": "Keep the supported Python version managed manually",
      "matchManagers": ["pep621"],
      "matchDepTypes": ["requires-python"],
      "enabled": false
    },
    {
      "matchManagers": ["pep621"],
      "rangeStrategy": "bump"
    },
    {
      "description": "ansible 14.x requires ansible-core 2.21.x; raise this when moving to ansible 15",
      "matchPackageNames": ["ansible-core"],
      "allowedVersions": "<2.22"
    }
  ]
}
