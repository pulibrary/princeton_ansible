# {{ ansible_managed | comment }}
# Catch-all server. Because this is the first config nginx loads, it answers
# every request whose Host header matches none of the sites we publish, such as
# scanners hitting the load balancer by IP address. It serves the static
# "nothing to see here" landing page and never proxies to a backend.

server {
    listen 80 default_server;
    server_name "{{ adc_domain }}";

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl default_server;
    server_name "{{ adc_domain }}";

    ssl_certificate            /etc/letsencrypt/live/{{ adc_domain }}/fullchain.pem;
    ssl_certificate_key        /etc/letsencrypt/live/{{ adc_domain }}/privkey.pem;
    ssl_session_cache          shared:SSL:1m;
    ssl_prefer_server_ciphers  on;

    root /var/local/www/default;

    # Every path answers with the landing page, so unknown URIs from scanners
    # never turn into filesystem lookups that fill up the error log.
    location / {
        try_files /index.html =404;
    }

    location = /pul-logo-new.svg {
        try_files $uri =404;
    }
}
