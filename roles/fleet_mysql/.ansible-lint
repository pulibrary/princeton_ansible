---
skip_list:
  - ANSIBLE0002
  - ANSIBLE0006
  - ANSIBLE0010
  - ANSIBLE0016
  - '303'
  - '305'
  - '306'
  - '403'
  - '503'
  - '204'
  - fqcn-builtins  # only one instance
  # This role is a drop-in replacement for the mysql role and deliberately
  # takes the same mysql_* variables, so anything written for that role works
  # here unchanged. Prefixing them fleet_mysql_* would break that.
  - var-naming[no-role-prefix]
use_default_rules: true
verbosity: 1
