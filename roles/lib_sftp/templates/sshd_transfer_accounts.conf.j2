#jinja2: trim_blocks: True, lstrip_blocks: True
# {{ ansible_managed }}
# SFTP transfer accounts, managed by the lib_sftp role.

{% if lib_sftp_allow_users | length > 0 %}
# AllowUsers accumulates across every sshd_config.d file rather than the first
# one winning, so this adds to whatever list the image or another role wrote.
# But if any AllowUsers exists anywhere, an account named in none of them is
# refused however else it is permitted, so these have to be listed here.
AllowUsers {{ lib_sftp_allow_users | join(' ') }}
{% endif %}
{% if lib_sftp_transfer_keys | length > 0 %}

# Keys for the transfer accounts are kept in a root-owned directory rather than
# in each account's home, because these are directory accounts whose home is
# only created on first login.
#
# The default location is listed FIRST and kept deliberately: replacing it
# instead of adding to it would lock out every account that keeps its key in its
# own home, including pulsys and the deploy user.
AuthorizedKeysFile .ssh/authorized_keys {{ lib_sftp_authorized_keys_dir }}/%u
PubkeyAuthentication yes
{% endif %}
{% if lib_sftp_password_auth_users | length > 0 %}

# Accounts whose remote partner cannot present a key. Password and
# keyboard-interactive are separate SSH methods, and an automated client is
# often built for only one of them, so both are enabled rather than guessing
# which it will ask for.
#
# The trailing `Match all` restores the global context, so anything parsed after
# this file is not silently made conditional on these users.
Match User {{ lib_sftp_password_auth_users | join(',') }}
    PasswordAuthentication yes
    KbdInteractiveAuthentication yes
Match all
{% endif %}
