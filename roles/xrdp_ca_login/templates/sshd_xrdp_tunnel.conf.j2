#jinja2: trim_blocks: True, lstrip_blocks: True
# {{ ansible_managed }}
# Remote desktop access, managed by the xrdp_ca_login role.
#
# The RDP listener is bound to loopback, so the only route to the login window is
# a forwarded port inside an SSH session. sshd permits forwarding by default;
# stating it here means a hardened base image cannot silently cut off desktop
# access.
AllowTcpForwarding yes
