#!/bin/sh
# {{ ansible_managed }}
#
# Sets the password for the caller's own remote desktop session.
#
# The desktop login window can only collect a password: xrdp answers every PAM
# prompt with the single string typed into its box, so no certificate and no
# cloud credential can be presented there. The desktop therefore keeps an
# ordinary local password.
#
# Rather than an administrator issuing that password, each person sets their own
# here, over an SSH session they could only open with a current certificate from
# the Library certificate authority. The account comes from SUDO_USER, so this
# command cannot be used to change anyone else's password.
set -eu

if [ "$(id -u)" -ne 0 ]; then
    echo "Run this with sudo: sudo {{ xrdp_ca_login_helper_path }}" >&2
    exit 1
fi

account="${SUDO_USER:-}"

if [ -z "$account" ] || [ "$account" = "root" ]; then
    echo "Could not tell which account to set a password for." >&2
    echo "Sign in as yourself, then run: sudo {{ xrdp_ca_login_helper_path }}" >&2
    exit 1
fi

if ! id -nG "$account" | tr ' ' '\n' | grep -qx '{{ xrdp_ca_login_group }}'; then
    echo "$account is not a remote desktop user on this host." >&2
    echo "Ask for the account to be added to {{ xrdp_ca_login_group }}." >&2
    exit 1
fi

port='{{ xrdp_ca_login_port }}'
# The name Ansible uses for this host, baked in when the file was written.
# Deliberately not `hostname -f`: this host reports "localhost" for that, which
# would print a command that tunnels the host to itself and appears to work.
host='{{ xrdp_ca_login_public_name }}'

cat <<MESSAGE
Setting the remote desktop password for $account.

This is a local password, not your Entra ID password, and it is only accepted by
the desktop login window on this host. That window listens on loopback, so the
password is no use on its own: reaching it means forwarding the port over SSH,
which needs a current certificate.

NEXT STEPS RUN ON YOUR OWN COMPUTER, NOT HERE. Open a second terminal on your
laptop or desktop and run:

    step ssh login $account@princeton.edu
    ssh -L $port:localhost:$port $account@$host

Leave that SSH session open, then point your RDP client at:

    localhost:$port

Point it at "localhost", NOT at $host. The whole arrangement is that the desktop
is reachable only through the tunnel that SSH session is holding open.

If you run the ssh command here on the server instead, you will see
"bind [127.0.0.1]:$port: Address already in use", because the desktop itself is
already listening there.

MESSAGE

exec passwd "$account"
