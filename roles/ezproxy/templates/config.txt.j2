
{{ ansible_managed | comment }}
Name {{ host_name }}

# IncludeFile hostname.txt

Option ProxyByHostname

## Loadbalancer IP ##
# initial install cannot have https
# Option ForceHTTPSLogin
# LoginPortSSL 443

##  By default, EZproxy listens on port 2048. 
LoginPort 80

## Shibboleth Configuration
# ShibbolethDisable 2.0
## Shibboleth Metadata (see: https://help.oclc.org/Library_Management/EZproxy/Authenticate_users/EZproxy_authentication_methods/SAML_authentication)
## Find out the need for Cert=3 below
# ShibbolethMetadata \
#   -EntityID=http://{{ host_name }} \
#   -File=MetadataFile \
#   -SignResponse=false -SignAssertion=true -EncryptAssertion=false \
#   -Cert=3 \
#   -URL=https://login.microsoftonline.com/{{ microsoft_entra_idp_uuid }}/federationmetadata/2007-06/federationmetadata.xml?appid={{ microsoft_entra_app_uuid }}

##  Connection limits. == see: http://www.oclc.org/support/documentation/ezproxy/cfg/limits.htm
MaxLifetime 30
MaxSessions 500
MaxVirtualHosts 17000
MaxConcurrentTransfers 300

## Adding Per OCLC Support Ticket
ChargeSetLatency SaveUsage 120

##  Securing EZproxy == see: http://www.oclc.org/support/documentation/ezproxy/example/securing.htm
Audit Most
AuditPurge 360
Option StatusUser
Option LogSession
IntruderIPAttempts -interval=5 -expires=15 20
IntruderUserAttempts -interval=5 -expires=15 10
UsageLimit -interval=10 -expires=120 -MB=300 -transfers=600 Global

## Set up Support for IP Geo Coding
Location -File=/usr/share/GeoIP/GeoLite2-City.mmdb
Option BlockCountryChange

## Monitor MaxVirtualHosts
Option RecordPeaks

## Log formatting
##
## EZproxy's LogFormat/LogSPU directives take a free-form format string, so it
## is told to write one JSON object per request instead of common log format.
## The OpenTelemetry Collector then reads named fields straight out of each
## line instead of matching a regex against it, and a field can be added here
## without also having to rewrite that regex.
##
## %u is a session identifier and not a username, because Option LogSession is
## set above rather than Option LogUser. Every value is quoted: EZproxy writes
## "-" for anything it has no value for, which would not be valid JSON sitting
## in a numeric position.
##
## The Jinja raw blocks below are needed because EZproxy's %{...}t time token
## looks like the start of a Jinja statement.
LogFormat {% raw %}{"timestamp":"%{%Y-%m-%dT%H:%M:%S%z}t","client_ip":"%h","session_id":"%u","http_method":"%m","url":"%U","virtual_host":"%v","http_protocol":"%{ezproxy-protocol}i","http_status":"%s","body_bytes_sent":"%b","duration_seconds":"%T","country_code":"%{Country()}e","user_agent":"%{user-agent}i","referer":"%{referer}i"}{% endraw %}

LogFile -strftime {{ ezproxy_access_log_pattern }}
## send logfiles to the log subdir
## log starting point URLs
LogSPU -strftime {{ ezproxy_spu_log_pattern }} {% raw %}{"timestamp":"%{%Y-%m-%dT%H:%M:%S%z}t","client_ip":"%h","session_id":"%u","http_method":"%m","url":"%U","virtual_host":"%v","spu_access":"%{ezproxy-spuaccess}i","http_status":"%s","body_bytes_sent":"%b"}{% endraw %}

