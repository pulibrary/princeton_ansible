// Sample k6 smoke test. Copy this file and edit it rather than changing it in
// place; Ansible will not overwrite it, but it will not update it either.
//
//   k6 run -e TARGET=https://catalog-staging.princeton.edu k6/smoke.js
import http from 'k6/http';
import { check, sleep } from 'k6';

export const options = {
  vus: 1,
  duration: '30s',
  thresholds: {
    http_req_failed: ['rate<0.01'],
    http_req_duration: ['p(95)<1000'],
  },
};

const target = __ENV.TARGET || 'https://library.princeton.edu';

export default function () {
  const res = http.get(target);
  check(res, { 'status is 200': (r) => r.status === 200 });
  sleep(1);
}
