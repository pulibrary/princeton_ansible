[Unit]
Description=Nomad inside rootless Docker namespaces
BindsTo=docker.service
PartOf=docker.service
After=docker.service

[Service]
ExecStart=/usr/local/bin/rootless-ns-exec /usr/local/bin/nomad agent -config /etc/nomad.d
ExecReload=/bin/kill -HUP $MAINPID
Delegate=yes
KillMode=mixed
KillSignal=SIGINT
LimitNOFILE=65536
LimitNPROC=infinity
TasksMax=infinity
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
