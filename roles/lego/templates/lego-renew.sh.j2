#!/bin/sh
# Managed by ansible role: lego
set -u

LEGO=/usr/local/bin/lego
DATA="{{ lego_data_dir }}"
EMAIL="{{ lego_email }}"
KEY_TYPE="{{ lego_key_type }}"
WEBROOT="{{ lego_webroot }}"
RENEW_DAYS="{{ lego_renew_days }}"
RENEW_HOOK="{{ lego_renew_hook }}"
{% if lego_acme_server %}
SERVER_FLAG="--server {{ lego_acme_server }}"
{% else %}
SERVER_FLAG=""
{% endif %}

ts() { date '+%Y-%m-%dT%H:%M:%S%z'; }
log() { echo "[$(ts)] $*"; }

issue_or_renew() {
    primary="$1"
    shift
    domain_flags=""
    for d in "$@"; do
        domain_flags="${domain_flags} --domains ${d}"
    done

    # lego v5: `run` issues a missing cert and renews an existing one;
    # the deploy hook only fires when a cert was actually written.
    log "issuing/renewing ${primary}"
    ${LEGO} run \
        --path "${DATA}" \
        --cert.name "${primary}" \
        --email "${EMAIL}" \
        --key-type "${KEY_TYPE}" \
        --accept-tos \
        --http \
        --http.webroot "${WEBROOT}" \
        ${SERVER_FLAG} \
        ${domain_flags} \
        --renew-days "${RENEW_DAYS}" \
        --deploy-hook "${RENEW_HOOK}"
    rc=$?
    if [ "${rc}" -ne 0 ]; then
        log "issue/renew of ${primary} failed (rc=${rc})"
        return 1
    fi
    log "issue/renew of ${primary} succeeded"
    return 0
}

log "lego-renew starting"

{% for cert in lego_certificates %}
issue_or_renew "{{ cert.primary | default(cert.domains[0]) }}" {% for d in cert.domains %}"{{ d }}" {% endfor %}

{% endfor %}

log "lego-renew finished"
