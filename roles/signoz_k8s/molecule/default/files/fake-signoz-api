#!/usr/bin/env python3
"""Test stand-in for the SigNoz rules and channels API (v0.151 routes).

Rules are listed as summaries from /api/v3/rules and read in full from
/api/v2/rules/{id}; GET /api/v2/rules answers 405 as on the real server.
Writes must use the v2alpha1 schema or they are rejected with 400, like
SigNoz from v0.150 on. Stored rules come back with the extra fields the
real server adds (id, state, audit fields, query step/stats/legend) so the
role's drift comparison is tested against realistic responses. Writes are
logged to REQUEST_LOG.
"""
import json
import uuid
from http.server import BaseHTTPRequestHandler, HTTPServer
from urllib.parse import parse_qs, urlsplit

API_KEY = "molecule-test-key"
STATE = "/var/lib/fake-signoz/rules.json"
REQUEST_LOG = "/var/lib/fake-signoz/requests.log"
CHANNELS = [{"id": "1", "name": "ops-email", "type": "email"}]
SUMMARY_FIELDS = ("id", "state", "alert", "description", "alertType", "ruleType", "disabled", "labels")


def load():
    with open(STATE) as f:
        return json.load(f)


def save(rules):
    with open(STATE, "w") as f:
        json.dump(rules, f)


def as_stored(rule, rule_id):
    stored = json.loads(json.dumps(rule))
    stored["id"] = rule_id
    stored["state"] = "inactive"
    stored["createdAt"] = "2026-01-01T00:00:00Z"
    stored["updatedAt"] = "2026-01-01T00:00:00Z"
    for query in stored["condition"]["compositeQuery"]["queries"]:
        query["spec"].update({"step": 0, "stats": False, "legend": ""})
    for threshold in stored["condition"]["thresholds"]["spec"]:
        threshold.setdefault("recoveryTarget", None)
    return stored


def invalid(rule):
    """Return the validation errors SigNoz v0.151 reports, or an empty list."""
    errors = []
    if rule.get("schemaVersion") != "v2alpha1":
        errors.append(f'schemaVersion: unsupported value "{rule.get("schemaVersion", "")}"; must be "v2alpha1"')
        return errors
    condition = rule.get("condition") or {}
    for field, value in (("condition.thresholds", condition.get("thresholds")),
                         ("evaluation", rule.get("evaluation")),
                         ("notificationSettings", rule.get("notificationSettings"))):
        if not value:
            errors.append(f'{field}: field is required for schemaVersion "v2alpha1"')
    for threshold in (condition.get("thresholds") or {}).get("spec") or []:
        if not threshold.get("name"):
            errors.append("condition.thresholds.spec[].name: field is required")
        if not threshold.get("channels") and not (rule.get("notificationSettings") or {}).get("usePolicy"):
            errors.append("condition.thresholds.spec[].channels: at least one channel is required")
    return errors


class Handler(BaseHTTPRequestHandler):
    def reply(self, code, data=None, errors=None):
        if errors:
            payload = {"status": "error", "error": {"message": "alert rule is not valid", "errors": errors}}
        else:
            payload = {"status": "success", "data": data}
        body = json.dumps(payload).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def authorised(self):
        if self.headers.get("SigNoz-Api-Key") == API_KEY:
            return True
        self.reply(401)
        return False

    def body(self):
        return json.loads(self.rfile.read(int(self.headers["Content-Length"])))

    def log_write(self):
        with open(REQUEST_LOG, "a") as f:
            f.write(f"{self.command} {self.path}\n")

    def do_GET(self):
        if not self.authorised():
            return
        url = urlsplit(self.path)
        if url.path == "/api/v1/channels":
            return self.reply(200, CHANNELS)
        if url.path == "/api/v2/rules":
            return self.reply(405)
        if url.path == "/api/v3/rules":
            rules = load()
            limit = min(int(parse_qs(url.query).get("limit", ["20"])[0]), 200)
            page = [{k: r[k] for k in SUMMARY_FIELDS if k in r} for r in rules[:limit]]
            return self.reply(200, {"rules": page, "total": len(rules), "labels": [], "reservedKeywords": []})
        for rule in load():
            if url.path == f"/api/v2/rules/{rule['id']}":
                return self.reply(200, rule)
        self.reply(404)

    def do_POST(self):
        if not self.authorised():
            return
        if self.path != "/api/v2/rules":
            return self.reply(404)
        self.log_write()
        rule = self.body()
        errors = invalid(rule)
        if errors:
            return self.reply(400, errors=errors)
        rules = load()
        stored = as_stored(rule, str(uuid.uuid4()))
        rules.append(stored)
        save(rules)
        self.reply(201, stored)

    def do_PUT(self):
        if not self.authorised():
            return
        rule_id = self.path.rsplit("/", 1)[-1]
        rules = load()
        for index, rule in enumerate(rules):
            if self.path == f"/api/v2/rules/{rule['id']}":
                self.log_write()
                body = self.body()
                errors = invalid(body)
                if errors:
                    return self.reply(400, errors=errors)
                rules[index] = as_stored(body, rule_id)
                save(rules)
                return self.reply(204)
        self.reply(404)

    def log_message(self, *args):
        pass


if __name__ == "__main__":
    HTTPServer(("127.0.0.1", 18080), Handler).serve_forever()
