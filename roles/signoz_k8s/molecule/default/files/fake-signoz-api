#!/usr/bin/env python3
"""Test stand-in for the SigNoz rules and channels API (v0.147 routes).

Stored rules come back with the extra fields the real server adds (id,
state, query step/stats/legend) so the role's drift comparison is tested
against realistic responses. Writes are logged to REQUEST_LOG.
"""
import json
import uuid
from http.server import BaseHTTPRequestHandler, HTTPServer

API_KEY = "molecule-test-key"
STATE = "/var/lib/fake-signoz/rules.json"
REQUEST_LOG = "/var/lib/fake-signoz/requests.log"
CHANNELS = [{"id": "1", "name": "ops-email", "type": "email"}]


def load():
    with open(STATE) as f:
        return json.load(f)


def save(rules):
    with open(STATE, "w") as f:
        json.dump(rules, f)


def as_stored(rule, rule_id):
    stored = json.loads(json.dumps(rule))
    stored["id"] = rule_id
    stored["state"] = "inactive"
    stored["createdAt"] = "2026-01-01T00:00:00Z"
    for query in stored["condition"]["compositeQuery"]["queries"]:
        query["spec"].update({"step": 0, "stats": False, "legend": ""})
    return stored


class Handler(BaseHTTPRequestHandler):
    def reply(self, code, data=None):
        body = json.dumps({"status": "success", "data": data}).encode()
        self.send_response(code)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(body)))
        self.end_headers()
        self.wfile.write(body)

    def authorised(self):
        if self.headers.get("SigNoz-Api-Key") == API_KEY:
            return True
        self.reply(401)
        return False

    def body(self):
        return json.loads(self.rfile.read(int(self.headers["Content-Length"])))

    def log_write(self):
        with open(REQUEST_LOG, "a") as f:
            f.write(f"{self.command} {self.path}\n")

    def do_GET(self):
        if not self.authorised():
            return
        if self.path == "/api/v1/channels":
            return self.reply(200, CHANNELS)
        if self.path == "/api/v2/rules":
            return self.reply(200, load())
        self.reply(404)

    def do_POST(self):
        if not self.authorised():
            return
        if self.path != "/api/v2/rules":
            return self.reply(404)
        self.log_write()
        rules = load()
        rule = as_stored(self.body(), str(uuid.uuid4()))
        rules.append(rule)
        save(rules)
        self.reply(201, rule)

    def do_PUT(self):
        if not self.authorised():
            return
        rule_id = self.path.rsplit("/", 1)[-1]
        rules = load()
        for index, rule in enumerate(rules):
            if self.path == f"/api/v2/rules/{rule['id']}":
                self.log_write()
                rules[index] = as_stored(self.body(), rule_id)
                save(rules)
                return self.reply(204)
        self.reply(404)

    def log_message(self, *args):
        pass


if __name__ == "__main__":
    HTTPServer(("127.0.0.1", 18080), Handler).serve_forever()
