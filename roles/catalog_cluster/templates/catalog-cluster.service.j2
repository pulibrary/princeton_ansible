[Unit]
Description=Catalog Cluster Application
After=network.target

[Service]
Type=simple
User={{ deploy_user }}
ExecStart={{ application_binary_path }}
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60
StartLimitBurst=5
StandardOutput=journal
StandardError=journal
Environment="APP_ENV={{ application_environment }}"
AmbientCapabilities = CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
