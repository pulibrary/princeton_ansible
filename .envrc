# shellcheck shell=bash
#
# direnv configuration for princeton_ansible.
#
# Entering this directory is equivalent to running `devbox shell`, and the
# Python/Ruby/Ansible dependencies are (re)installed automatically whenever the
# lock files change. Run `direnv allow` once to approve this file.

if ! has devbox; then
  log_error "devbox is not installed or not on PATH. Run bin/first-time-setup.sh, then re-enter this directory."
  exit 0
fi

use_devbox() {
  eval "$(devbox shellenv --init-hook --install --no-refresh-alias)"
  watch_file "$DEVBOX_PROJECT_ROOT/devbox.json" "$DEVBOX_PROJECT_ROOT/devbox.lock"
}

# The .venv here is managed by uv, not by Devbox's Python plugin. This marker
# answers the plugin's "overwrite it?" prompt once, so loading never blocks.
mkdir -p .devbox
touch .devbox/venv_check_completed

use devbox

watch_file uv.lock pyproject.toml

bin/devbox-bootstrap
